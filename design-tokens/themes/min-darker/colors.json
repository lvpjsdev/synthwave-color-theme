      "tab": { "value": "#070707", "description": "Tab border" }
    },
    "semantic": {
      "success": { "value": "#3a632a", "description": "Success/added" },
      "error": { "value": "#880638", "description": "Error/removed" },
      "info": { "value": "#316bcd", "description": "Info" },
      "warning": { "value": "#cd9731", "description": "Warning" }
    },
    "indentGuide": {
      "default": { "value": "#2A2A2A", "description": "Indent guide" },
      "active": { "value": "#383838", "description": "Active indent guide" }
